{
  "info": {
    "name": "SIPUS-Del Web Services (SOAP & REST API v1) - 12S24017",
    "_postman_id": "a9c12017-2026-4999-b123-sipusdelweek9",
    "description": "Koleksi Pengujian Lengkap SOAP Bebas Pustaka & RESTful API v1 SIPUS-Del Minggu 9.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "root_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "base_url", "value": "http://localhost:8000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "if (requestName.startsWith('6. ')) {",
          "    pm.collectionVariables.set('test_isbn', '978' + Date.now().toString());",
          "}",
          "if (requestName.startsWith('9. ')) {",
          "    pm.collectionVariables.set('test_nim', '12S' + Date.now().toString());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestNumber = pm.info.requestName.match(/^\\d+/)[0];",
          "const expectedStatuses = {",
          "    '1': [200], '2': [200], '3': [500], '4': [200], '5': [200],",
          "    '6': [201], '7': [200], '8': [200], '9': [201], '10': [200],",
          "    '11': [200], '12': [200]",
          "};",
          "pm.test('HTTP status sesuai skenario', function () {",
          "    pm.expect(expectedStatuses[requestNumber]).to.include(pm.response.code);",
          "});",
          "if (['4', '5', '6', '7', '8', '9', '10', '11', '12'].includes(requestNumber) && [200, 201].includes(pm.response.code)) {",
          "    pm.test('Respons API sukses memiliki format yang konsisten', function () {",
          "        const body = pm.response.json();",
          "        pm.expect(body.success).to.eql(true);",
          "        pm.expect(body).to.have.property('data');",
          "    });",
          "}",
          "if (requestNumber === '6' && pm.response.code === 201) {",
          "    const data = pm.response.json().data;",
          "    pm.collectionVariables.set('book_id', data.id.toString());",
          "    pm.test('POST buku mengembalikan Location', function () {",
          "        pm.expect(pm.response.headers.has('Location')).to.be.true;",
          "    });",
          "}",
          "if (requestNumber === '9' && pm.response.code === 201) {",
          "    const data = pm.response.json().data;",
          "    pm.collectionVariables.set('loan_id', data.id.toString());",
          "    pm.test('POST peminjaman mengembalikan Location', function () {",
          "        pm.expect(pm.response.headers.has('Location')).to.be.true;",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. SOAP Legacy - Get WSDL Contract",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{root_url}}/soap/sipus.wsdl"
      }
    },
    {
      "name": "2. SOAP Legacy - CheckClearanceStatus (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/clearance\">\n  <soap:Body>\n    <m:CheckClearanceStatus>\n      <m:nim_peminjam>12S24017</m:nim_peminjam>\n    </m:CheckClearanceStatus>\n  </soap:Body>\n</soap:Envelope>"
        },
        "url": "{{root_url}}/soap/sipus"
      }
    },
    {
      "name": "3. SOAP Legacy - CheckClearanceStatus (<soap:Fault> 500)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <CheckClearanceStatus>\n      <nim_peminjam></nim_peminjam>\n    </CheckClearanceStatus>\n  </soap:Body>\n</soap:Envelope>"
        },
        "url": "{{root_url}}/soap/sipus"
      }
    },
    {
      "name": "4. Auth - Login Pustakawan (Get Bearer Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.access_token) {",
              "    pm.collectionVariables.set('token', jsonData.data.access_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"pustakawan@del.ac.id\",\n  \"password\": \"password123\",\n  \"device_name\": \"postman-arya-12S24017\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "5. Katalog Buku - GET Paginated + Filter + HATEOAS",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/bukus?per_page=5&tersedia=1&sort=judul&dir=asc"
      }
    },
    {
      "name": "6. Katalog Buku - POST Buku Baru (201 Created + Location)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kategori_id\": 1,\n  \"isbn\": \"{{test_isbn}}\",\n  \"judul\": \"Clean Code: A Handbook of Agile Software Craftsmanship\",\n  \"penulis\": \"Robert C. Martin\",\n  \"penerbit\": \"Prentice Hall\",\n  \"tahun_terbit\": 2008,\n  \"stok\": 1\n}"
        },
        "url": "{{base_url}}/bukus"
      }
    },
    {
      "name": "7. Katalog Buku - PATCH Stok Saja (Partial Update)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stok\": 2\n}"
        },
        "url": "{{base_url}}/bukus/{{book_id}}"
      }
    },
    {
      "name": "8. Katalog Buku - PUT Full Replacement (Tanpa penerbit -> null)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kategori_id\": 1,\n  \"isbn\": \"{{test_isbn}}\",\n  \"judul\": \"Clean Code (Revised Edition)\",\n  \"penulis\": \"Robert C. Martin\",\n  \"stok\": 1\n}"
        },
        "url": "{{base_url}}/bukus/{{book_id}}"
      }
    },
    {
      "name": "9. Sirkulasi ACID - POST Pinjam Buku (201 Created / 409 / 422)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"buku_id\": {{book_id}},\n  \"nim_peminjam\": \"{{test_nim}}\",\n  \"nama_peminjam\": \"Arya Pratama Sinambela\",\n  \"durasi_hari\": 7\n}"
        },
        "url": "{{base_url}}/peminjamans"
      }
    },
    {
      "name": "10. Sirkulasi ACID - PATCH Kembalikan Buku (200 OK / 409 Conflict)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/peminjamans/{{loan_id}}/kembalikan"
      }
    },
    {
      "name": "11. REST Consumer - GET Referensi Eksternal OpenLibrary API",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/bukus/{{book_id}}/referensi-eksternal"
      }
    },
    {
      "name": "12. REST Consumer - GET GitHub Portfolio API",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/portfolios/github/AryaSinambela"
      }
    }
  ]
}